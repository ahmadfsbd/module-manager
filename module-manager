#!/bin/bash

# Base paths
MODULES_DIR="/genesandhealth/lmod/modules"
USER_BIN="$HOME/.local/share/modules/bin"
LOADED_LIST="$HOME/.local/share/modules/loaded"

mkdir -p "$USER_BIN"
mkdir -p "$(dirname "$LOADED_LIST")"

load_module() {
    local module_name="$1"
    local module_path="$MODULES_DIR/$module_name"
    local sif="$module_path/singularity.sif"
    local meta="$module_path/meta.yaml"

    if grep -Fxq "$module_name" "$LOADED_LIST" 2>/dev/null; then
        echo "Module '$module_name' is already loaded."
        return 0
    fi

    if [[ ! -f "$sif" ]]; then
        echo "Missing container: $sif"
        return 1
    fi

    if [[ ! -f "$meta" ]]; then
        echo "Missing meta.yaml for module: $module_name"
        return 1
    fi

    # Mark as loaded
    echo "$module_name" >> "$LOADED_LIST"

    # Read executables from meta.yaml
    local isR=false
    local cmds
    cmds=$(yq '.executables[]' "$meta")
    for cmd in $cmds; do
        if [[ "$cmd" == "R" ]]; then
            isR=true
        fi

        script_path="$USER_BIN/$cmd"
        cat <<EOF > "$script_path"
#!/bin/bash
exec singularity exec --bind "/genesandhealth:/genesandhealth" "$sif" "$cmd" "\$@"
EOF
        chmod +x "$script_path"
    done

    if [[ "$isR" == true ]]; then
        load_rstudio "$sif"
    fi

    echo "Module '$module_name' loaded."
}

load_rstudio() {
    local sif="$1"

    script_path="$USER_BIN/rstudio"
    cat <<EOF > "$script_path"
#!/bin/bash
singularity exec --overlay /genesandhealth/lmod/modules/rstudio.sqfs "$sif" /opt/rstudio/rstudio
EOF
    chmod +x "$script_path"
}

unload_module() {
    local module_name="$1"
    local module_path="$MODULES_DIR/$module_name"
    local meta="$module_path/meta.yaml"

    if ! grep -Fxq "$module_name" "$LOADED_LIST" 2>/dev/null; then
        echo "Module '$module_name' is already unloaded."
        return 0
    fi

    if [[ ! -f "$meta" ]]; then
        echo "Missing meta.yaml for module: $module_name"
        return 1
    fi

    # Remove module from loaded list using in-place sed
    sed -i '/^'"$module_name"'$/d' "$LOADED_LIST"

    # Remove all exported command wrappers
    rm -f "$USER_BIN"/*

    while read -r mod; do
        local mod_path="$MODULES_DIR/$mod"
        local mod_meta="$mod_path/meta.yaml"
        local mod_sif="$mod_path/singularity.sif"
        local isR=false

        if [[ -f "$mod_meta" ]]; then
            # Use process substitution to avoid subshell
            while read -r cmd; do
                if [[ "$cmd" == "R" ]]; then
                    isR=true
                fi

                cat > "$USER_BIN/$cmd" <<EOF
#!/bin/bash
exec singularity exec "$mod_sif" "$cmd" "\$@"
EOF
                chmod +x "$USER_BIN/$cmd"
            done < <(yq -r '.executables[]' "$mod_meta")

            if [[ "$isR" == true ]]; then
                load_rstudio "$mod_sif"
            fi
        fi
    done < "$LOADED_LIST"

    echo "Module '$module_name' unloaded and command wrappers updated."
}

restore_modules() {
    if [[ ! -f "$LOADED_LIST" ]]; then
        echo "No loaded modules file found at $LOADED_LIST"
        return 1
    fi

    echo "Restoring loaded modules from $LOADED_LIST..."
    rm -f "$USER_BIN"/*

    while IFS= read -r module_name; do
        load_module "$module_name"
    done < "$LOADED_LIST"
}

list_available() {
    echo "Available modules:"
    echo "------------------"
    if [[ -d "$MODULES_DIR" ]]; then
        for mod in "$MODULES_DIR"/*/; do
            echo "- $(basename "${mod%/}")"
        done
    else
        echo "No modules directory found."
    fi
}

list_loaded() {
    echo "Loaded modules:"
    echo "----------------"
    if [[ ! -s "$LOADED_LIST" ]]; then
        echo "None loaded."
        return
    fi

    # Read all module names into an array
    mapfile -t modules < "$LOADED_LIST"

    # Iterate in reverse order
    for (( idx=${#modules[@]}-1; idx>=0; idx-- )); do
        module_name="${modules[idx]}"
        echo "- $module_name"
        local meta_file="$MODULES_DIR/$module_name/meta.yaml"
        if [[ -f "$meta_file" ]]; then
            # Use yq -r to get raw strings
            yq -r '.executables[]' "$meta_file" | while IFS= read -r cmd; do
                echo "    └─ $cmd"
            done
        else
            echo "    └─ (No meta.yaml found)"
        fi
    done
}

status_module() {
    local module_name="$1"
    local module_path="$MODULES_DIR/$module_name"
    local meta_file="$module_path/meta.yaml"

    echo "Status for module: $module_name"
    echo "-------------------------------"

    if [[ -d "$module_path" ]]; then
        echo "[OK] Module exists in $MODULES_DIR"
    else
        echo "[X] Module does not exist in $MODULES_DIR"
        return 1
    fi

    if grep -Fxq "$module_name" "$LOADED_LIST" 2>/dev/null; then
        echo "[LOADED] Module is currently loaded"
    else
        echo "[NOT LOADED] Module is not loaded"
    fi

    if [[ -f "$meta_file" ]]; then
        echo "[INFO] Exported commands:"
        yq '.executables[]' "$meta_file" | sed 's/^/    └─ /'
    else
        echo "[WARN] No meta.yaml found"
    fi
}

unload_all() {
    if [[ ! -s "$LOADED_LIST" ]]; then
        echo "No modules are currently loaded."
        return 0
    fi

    echo "Unloading all modules..."
    
    # Display what is being unloaded
    echo "Modules to unload:"
    cat "$LOADED_LIST" | sed 's/^/ - /'

    # Clear loaded list
    > "$LOADED_LIST"

    # Remove all exported command wrappers
    rm -f "$USER_BIN"/*

    echo "All modules have been unloaded and command wrappers removed."
}

# --- Entry point ---
case "$1" in
    load)
        load_module "$2"
        ;;
    unload)
        unload_module "$2"
        ;;
    restore)
        restore_modules
        ;;
    list-available)
        list_available
        ;;
    list-loaded)
	list_loaded
	;;
    status)
        status_module "$2"
        ;;
    unload-all)
        unload_all
        ;;
    *)
        echo "Usage: $0 {load|unload|restore|list-available|list-loaded|status|unload-all} [module_name]"
        ;;
esac
